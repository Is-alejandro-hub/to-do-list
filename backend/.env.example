# Copia este archivo a .env y rellena tus credenciales reales.
# El .env está en .gitignore y NO debe subirse a Git.

SERVER_PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:4200
CLEANUP_INTERVAL_MS=3600000

DB_HOST=localhost
DB_PORT=5432
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=todo_db
DB_SSLMODE=disable